APP_NAME="AI Agent System"
DEBUG=false


# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resumer_qa

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_chunks

# Embeddings (changing the model needs a vector migration)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_PROVIDER=hf-inference
EMBEDDING_SIZE=768
EMBEDDING_TIMEOUT=60

# Auth (JWT)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# Hugging Face
HF_TOKEN=

# Default LLM for agents that don't set their own (Hugging Face inference provider)
DEFAULT_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
DEFAULT_PROVIDER=deepinfra
DEFAULT_FALLBACK_PROVIDER=
DEFAULT_TEMPERATURE=0.01
DEFAULT_MAX_TOKENS=1024
DEFAULT_TIMEOUT=60

# Every LLM call is logged here (metadata only)
LLM_LOG_FILE=logs/llm_calls.jsonl

# Query planner (small fast model, reads only the question)
PLANNER_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
PLANNER_PROVIDER=groq
PLANNER_FALLBACK_PROVIDER=deepinfra
PLANNER_MAX_TOKENS=150
PLANNER_TIMEOUT=20

# Job description parser
JD_PARSER_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
JD_PARSER_PROVIDER=deepinfra
JD_PARSER_FALLBACK_PROVIDER=
JD_PARSER_MAX_TOKENS=1024
JD_PARSER_TIMEOUT=60
JD_MAX_FILE_BYTES=2000000

# Resume parser
PARSER_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
PARSER_PROVIDER=deepinfra
PARSER_FALLBACK_PROVIDER=
PARSER_MAX_NEW_TOKENS=800
PARSER_TEMPERATURE=0.01
PARSER_TIMEOUT=90
PARSER_GAP_RATIO=0.15
PARSER_MAX_WORDS=8
PARSER_CONCURRENCY=4
PARSER_INPUT_DIR=resumes
PARSER_OUTPUT_DIR=outputs
