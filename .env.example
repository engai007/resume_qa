APP_NAME="AI Agent System"
DEBUG=false


# Hugging Face
HF_TOKEN=

# Default LLM for agents that don't set their own (Hugging Face inference provider)
DEFAULT_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
DEFAULT_PROVIDER=deepinfra
DEFAULT_TEMPERATURE=0.01
DEFAULT_MAX_TOKENS=1024
DEFAULT_TIMEOUT=120

# Every LLM call is logged here (metadata only)
LLM_LOG_FILE=logs/llm_calls.jsonl

# Resume parser
PARSER_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
PARSER_PROVIDER=deepinfra
PARSER_MAX_NEW_TOKENS=800
PARSER_TEMPERATURE=0.01
PARSER_TIMEOUT=600
PARSER_GAP_RATIO=0.15
PARSER_MAX_WORDS=8
PARSER_CONCURRENCY=4
PARSER_INPUT_DIR=resumes
PARSER_OUTPUT_DIR=outputs
